# Researchly Environment Configuration Template

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
# Model overrides. Unset uses the defaults in app/core/config.py, which
# were verified against a live key: gemini-embedding-001 (pinned to 768
# dims, matching the paper_chunks.embedding column) and
# gemini-3.8-flash. Set these only to a model your project can actually
# reach — availability is per-project, not global, and the free tier
# refuses newer sign-ups the 2.5 and 2.0 families. A retired or
# unavailable model fails the readiness probe (/api/health/ready).
# GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
# GEMINI_GENERATION_MODEL=models/gemini-3.8-flash

# Supabase Infrastructure
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Frontend Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
VITE_API_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Backend settings (Part 18). All optional in development; the API refuses
# to boot with ENVIRONMENT=production unless the security-relevant ones
# are set correctly.
# ---------------------------------------------------------------------------

# development | test | staging | production. Anything else is rejected:
# a typo must not silently leave the app in development mode.
ENVIRONMENT=development

# Comma-separated origins, or a JSON array. In production every entry
# must be https and non-local, and "*" is refused (it is combined with
# allow_credentials, which would trust every site on the internet).
# CORS_ORIGINS=["https://app.example.com"]

# Largest accepted upload, in megabytes. The Supabase bucket enforces
# the same ceiling.
MAX_UPLOAD_MB=50

# Inbound rate limits, per client, over a sliding window. The general
# budget covers the whole API; the AI budget covers the endpoints that
# call Gemini (chat, search, research, upload).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_AI_REQUESTS=30
RATE_LIMIT_AI_WINDOW_SECONDS=60

# Enable ONLY when deployed behind a proxy or load balancer that
# overwrites X-Forwarded-For. It is how the client address is identified
# for rate limiting; with it off, every client behind the proxy shares
# one budget. Required in production.
TRUST_PROXY_HEADERS=false
